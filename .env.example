# Sport Market Review — мобільний застосунок (Expo).
# Скопіюйте у .env і заповніть. Реальні значення НЕ комітяться.
#
# DATA_MODE: 'mock' — локальні дані (лише розробка); 'supabase' — production.
# У режимі supabase ключі обовʼязкові, інакше застосунок падає (без тихого fallback).
EXPO_PUBLIC_DATA_MODE=mock

# Supabase → Project Settings → API. anon key — публічний, безпечно у client.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# service_role key у мобільний клієнт НЕ додається — лише на захищеному сервері.
