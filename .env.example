# SMR — приклад змінних середовища. РЕАЛЬНІ значення сюди НЕ комітити.
# Реальні секрети встановлюються лише через server environment (VPS / hosting).

# --- Режим даних ---
DATA_MODE=supabase                 # supabase | mock (production ЗАВЖДИ supabase)
APP_ENV=production                 # local | development | staging | production

# --- Supabase (public — потрапляють у клієнт) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only — НІКОЛИ не в клієнт/бандл/логи) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Адмінка / CORS ---
ADMIN_ORIGIN=https://admin.example.com

# --- Cron (захист службових ендпоінтів) ---
CRON_SECRET=

# --- Email-провайдер (M7 foundation; підключити перед beta) ---
# EMAIL_PROVIDER=resend|postmark
# EMAIL_API_KEY=
# EMAIL_SENDER=no-reply@example.com

# --- Push (Expo; mobile на паузі) ---
# EXPO_ACCESS_TOKEN=

# --- Observability (M7 план) ---
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
