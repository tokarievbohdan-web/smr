# PRODUCTION (VPS) — web. Скопіюйте у .env.production і заповніть реальними.
# Обов'язково DATA_MODE=supabase. Відсутність ключів → застосунок НЕ стартує
# (контрольована помилка), і НЕ переходить на mock.
DATA_MODE=supabase

NEXT_PUBLIC_SUPABASE_URL=https://esanyyhwabqwmvmisauy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon/publishable key>

# server-only секрети (тримати у секрет-менеджері/оточенні PM2, не у Git):
SUPABASE_SERVICE_ROLE_KEY=<service_role key — Supabase → Settings → API>
SUPABASE_DATABASE_URL=postgresql://postgres:<PASSWORD>@db.esanyyhwabqwmvmisauy.supabase.co:5432/postgres

ADMIN_ORIGIN=https://admin.sportmarket.review
