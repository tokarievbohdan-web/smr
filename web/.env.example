# Sport Market Review — web (Next.js). Скопіюйте у .env.local (dev),
# .env.staging / .env.production на сервері. Реальні значення НЕ комітяться.
#
# DATA_MODE: 'mock' — локальний контент (розробка); 'supabase' — production.
# У production DATA_MODE=supabase; відсутність ключів → контрольована помилка
# запуску (без тихого fallback на mock) — див. web/src/server/env.ts.
DATA_MODE=mock

# Публічні (можна у client bundle):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ЛИШЕ на сервері (route handlers). НІКОЛИ не з префіксом NEXT_PUBLIC,
# не в client-коді, не в admin SPA, не в логах, не в Git:
SUPABASE_SERVICE_ROLE_KEY=
# Пряме підключення до БД (міграції/скрипти seed). Містить пароль — server-only.
SUPABASE_DATABASE_URL=

# Origin адмінки для CORS привілейованих ендпоінтів (без wildcard у production).
ADMIN_ORIGIN=https://admin.sportmarket.review

# Секрет для cron-ендпоінта публікації запланованих (заголовок x-cron-secret).
CRON_SECRET=

# Публічний URL сайту (sitemap/robots/canonical).
NEXT_PUBLIC_SITE_URL=https://sportmarket.review
