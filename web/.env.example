# Sport Market Review — web (Next.js). Скопіюйте у .env.local.
# Реальні значення НЕ комітяться.
#
# DATA_MODE: 'mock' — локальний контент (розробка); 'supabase' — production.
DATA_MODE=mock

# Публічні (можна у client bundle):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ЛИШЕ на сервері (server actions / route handlers). НІКОЛИ не з префіксом NEXT_PUBLIC
# і не в client-коді:
SUPABASE_SERVICE_ROLE_KEY=
